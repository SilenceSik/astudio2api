# 复制为 .env 后按需修改。绝不提交真值。
# 网关启动时自行读取，不需要额外加载器（systemd 用 EnvironmentFile=）。

# ── 网关自身 ──────────────────────────────────────────────────────────
# 访问密钥。留空 = 不校验，仅供本机自用；对外监听前务必设置随机值。
ASTUDIO_API_KEY=

# 监听地址与端口。绑 0.0.0.0 才能被容器经 docker 网关访问到。
ASTUDIO_HOST=127.0.0.1
ASTUDIO_PORT=8788

# ── 数据落点 ──────────────────────────────────────────────────────────
# 账号目录（内含 ssoSessionId / modelBearerToken，务必 600 且不要提交）
ASTUDIO_ACCOUNTS_DIR=./accounts
# 台账文件（签到记录 + 积分快照 + 模型缓存）
ASTUDIO_STATE_PATH=./state.json
# AStudio 客户端活会话文件。留空 = 自动探测常见位置。
ASTUDIO_SESSION_PATH=

# ── 可选：加账号工具 ──────────────────────────────────────────────────
# 只写本地账号目录时留空；要顺带推到远端才需要下面三项。
ASTUDIO_SSH_HOST=
ASTUDIO_SSH_KEY=
ASTUDIO_REMOTE_DIR=/opt/astudio2api
ASTUDIO_REMOTE_SERVICE=astudio2api

# 浏览器装在了非默认盘时，把 user-data 根目录加进来（分号或冒号分隔），
# 供 tools/harvest_account.py 从历史库取证。
ASTUDIO_BROWSER_DATA=

# ── 可选：部署与验证脚本 ──────────────────────────────────────────────
# 网关地址（从容器视角看宿主的地址）
ASTUDIO_HOST_URL=http://172.17.0.1:8788
# new-api 的 SQLite 与其凭据文件
NEWAPI_DB=/opt/new-api/data/new-api.db
NEWAPI_ENV_FILE=/root/.cnb/newapi.env
# 注册渠道时用的分组（逗号分隔）
NEWAPI_GROUPS=openai
# 已有渠道的 id（verify_channel.sh 用）
CHANNEL_ID=1
